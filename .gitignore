# sweep outputs -- regenerated by every run, not meant to live in git.
# ** matches any depth, so this covers Single_parameter_sweeps/,
# Sweep_two_parameters/, sweep_one_parameter_turn_on_off/, and any future
# subfolder -- not just direct children of Paramter_sweep/. Scripts like
# plot_*.py / sweep_core.py are still tracked since only these extensions
# and directory names match.
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/sweep_*/*.csv
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/sweep_*/*.json
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/sweep_*/*.png
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/Two_parameters_varied_results_*/
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/meshes_conformal/
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/*.out
Sender_Receiver/My_sender_receiver/Paramter_sweep/**/*.err
__pycache__/
*.pyc
.DS_Store
