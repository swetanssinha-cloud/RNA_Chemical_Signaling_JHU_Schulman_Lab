    "import numpy as np\n",
    "\n",
    "x = 1e-16\n",
    "\n",
    "direct = np.sqrt(1+x) - 1\n",
    "reform = x/(np.sqrt(1+x)+1)\n",
    "\n",
    "print(\"x = \", x)\n",
    "\n",
    "print(\"direct =\", (direct))\n",
    "print(\"reformulated=\", reform)\n"
   ]
  }
